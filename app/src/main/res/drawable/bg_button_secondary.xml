<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle"><solid android:color="#111D2D" /><corners android:radius="10dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="@color/button_secondary_pressed" /><corners android:radius="10dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="@color/button_secondary" /><stroke android:width="1dp" android:color="@color/panel_border" /><corners android:radius="10dp" /></shape>
    </item>
</selector>
