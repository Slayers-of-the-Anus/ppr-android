<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <!-- Robot mode: landscape, read-only telemetry with one setup button. -->
    <LinearLayout
        android:id="@+id/robotMode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_brand_mark"
                android:gravity="center"
                android:text="PP"
                android:textColor="@color/ink"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.08"
                    android:text="PHONEPILOT  /  ROBOT MODE"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp" />

                <TextView
                    android:id="@+id/robotIdentity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="phone_01  ·  Courier Android"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/robotHealth"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/bg_status_neutral"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="●  SYSTEM CHECK"
                android:textColor="@color/warning"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/robotSettingsButton"
                style="@style/Widget.PhonePilot.Button.Primary"
                android:layout_width="148dp"
                android:layout_height="44dp"
                android:text="OPEN SETUP" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="18dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.05"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/serverState"
                        style="@style/Widget.PhonePilot.TelemetryCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="SERVER\n●  Disconnected" />

                    <TextView
                        android:id="@+id/boardState"
                        style="@style/Widget.PhonePilot.TelemetryCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="CONTROL BOARD\n●  Disconnected" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/cameraState"
                        style="@style/Widget.PhonePilot.TelemetryCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="CAMERA / STREAM\n●  Starting" />

                    <TextView
                        android:id="@+id/viewerState"
                        style="@style/Widget.PhonePilot.TelemetryCard"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="VIEWERS\n●  0 / 4" />
                </LinearLayout>

                <TextView
                    android:id="@+id/robotDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_panel_dark"
                    android:fontFamily="monospace"
                    android:padding="14dp"
                    android:text="Control link: USB cable   •   Hotspot: stopped"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_weight="0.95"
                android:background="@drawable/bg_panel_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:letterSpacing="0.12"
                        android:text="EVENT LOG"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LIVE"
                        android:textColor="@color/success"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/divider" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/eventLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="4dp"
                        android:textColor="@color/text_secondary"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Setup mode: portrait, compact controls with a small unobtrusive preview. -->
    <ScrollView
        android:id="@+id/setupMode"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Setup"
                        android:textColor="@color/text_primary"
                        android:textSize="27sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="PhonePilot configuration"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/setupRobotModeButton"
                        style="@style/Widget.PhonePilot.Button.Outline"
                        android:layout_width="132dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="8dp"
                        android:text="ROBOT MODE" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="142dp"
                    android:layout_height="94dp"
                    android:background="@drawable/bg_preview_frame"
                    android:padding="3dp">

                    <org.webrtc.SurfaceViewRenderer
                        android:id="@+id/preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|end"
                        android:layout_margin="6dp"
                        android:background="@drawable/bg_camera_badge"
                        android:paddingStart="6dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="3dp"
                        android:text="● LIVE"
                        android:textColor="@color/success"
                        android:textSize="8sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.PhonePilot.SectionTitle"
                    android:text="SERVER &amp; ROBOT" />

                <EditText
                    android:id="@+id/serverUrl"
                    style="@style/Widget.PhonePilot.Input"
                    android:layout_marginTop="12dp"
                    android:hint="Server URL"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/robotId"
                    style="@style/Widget.PhonePilot.Input"
                    android:layout_marginTop="8dp"
                    android:hint="Robot ID"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/robotName"
                    style="@style/Widget.PhonePilot.Input"
                    android:layout_marginTop="8dp"
                    android:hint="Robot name"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords"
                    android:singleLine="true" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/connectButton"
                        style="@style/Widget.PhonePilot.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:text="CONNECT" />

                    <Button
                        android:id="@+id/disconnectButton"
                        style="@style/Widget.PhonePilot.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="DISCONNECT" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_dark"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Widget.PhonePilot.SectionTitle"
                        android:text="CAMERA" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="1280 × 720  ·  30 FPS"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/switchCameraButton"
                    style="@style/Widget.PhonePilot.Button.Secondary"
                    android:layout_width="128dp"
                    android:layout_height="42dp"
                    android:text="SWITCH CAMERA" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.PhonePilot.SectionTitle"
                    android:text="ESP32 CONTROL" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="CONTROL LINK"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/transportModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/usbTransportButton"
                        style="@style/Widget.PhonePilot.Radio"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:checked="true"
                        android:text="USB CABLE" />

                    <RadioButton
                        android:id="@+id/wifiTransportButton"
                        style="@style/Widget.PhonePilot.Radio"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="PHONE HOTSPOT" />

                    <RadioButton
                        android:id="@+id/sharedTransportButton"
                        style="@style/Widget.PhonePilot.Radio"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="SHARED WI-FI NETWORK" />
                </RadioGroup>

                <Button
                    android:id="@+id/hotspotButton"
                    style="@style/Widget.PhonePilot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="8dp"
                    android:text="START ESP32 HOTSPOT" />

                <TextView
                    android:id="@+id/hotspotCredentials"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_inset"
                    android:fontFamily="monospace"
                    android:padding="10dp"
                    android:text="Hotspot: stopped"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/sendWifiCredentialsButton"
                    style="@style/Widget.PhonePilot.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:enabled="false"
                    android:text="SEND WI-FI TO ESP32 VIA USB" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.PhonePilot.SectionTitle"
                    android:text="ESP32 NETWORK SETUP" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Select the board mode and send it via USB or its temporary setup Wi-Fi. Android can read the current network name, but not its saved password."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <RadioGroup
                    android:id="@+id/boardModeGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/boardSharedMode"
                        style="@style/Widget.PhonePilot.Radio"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:checked="true"
                        android:text="JOIN SHARED WI-FI" />

                    <RadioButton
                        android:id="@+id/boardHotspotMode"
                        style="@style/Widget.PhonePilot.Radio"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="JOIN PHONE HOTSPOT" />

                    <RadioButton
                        android:id="@+id/boardUsbMode"
                        style="@style/Widget.PhonePilot.Radio"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="USB ONLY" />
                </RadioGroup>

                <Button
                    android:id="@+id/readCurrentNetworkButton"
                    style="@style/Widget.PhonePilot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:text="USE PHONE'S CURRENT WI-FI NAME" />

                <EditText
                    android:id="@+id/sharedWifiSsid"
                    style="@style/Widget.PhonePilot.Input"
                    android:layout_marginTop="8dp"
                    android:hint="Shared Wi-Fi name (SSID)"
                    android:inputType="text"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/sharedWifiPassword"
                    style="@style/Widget.PhonePilot.Input"
                    android:layout_marginTop="8dp"
                    android:hint="Shared Wi-Fi password — enter once"
                    android:inputType="textPassword"
                    android:saveEnabled="false"
                    android:singleLine="true" />

                <RadioGroup
                    android:id="@+id/provisionPathGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/provisionUsb"
                        style="@style/Widget.PhonePilot.Radio"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:checked="true"
                        android:text="VIA USB" />

                    <RadioButton
                        android:id="@+id/provisionSetupWifi"
                        style="@style/Widget.PhonePilot.Radio"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="VIA SETUP WI-FI" />
                </RadioGroup>

                <EditText
                    android:id="@+id/espSetupSsid"
                    style="@style/Widget.PhonePilot.Input"
                    android:layout_marginTop="8dp"
                    android:hint="PhonePilot-Setup-… network name"
                    android:inputType="text"
                    android:singleLine="true" />

                <EditText
                    android:id="@+id/espSetupPassword"
                    style="@style/Widget.PhonePilot.Input"
                    android:layout_marginTop="8dp"
                    android:hint="Setup password shown in Arduino Serial Monitor"
                    android:inputType="textPassword"
                    android:saveEnabled="false"
                    android:singleLine="true" />

                <Button
                    android:id="@+id/sendBoardConfigurationButton"
                    style="@style/Widget.PhonePilot.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:text="SEND MODE &amp; NETWORK TO ESP32" />

                <TextView
                    android:id="@+id/boardConfigurationResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enter the shared Wi-Fi password to provision ESP32."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_panel_dark"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Widget.PhonePilot.SectionTitle"
                    android:text="SYSTEM STATUS" />

                <TextView
                    android:id="@+id/viewers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Viewers: 0/4 · nobody connected"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:text="Server: disconnected\nCamera: starting\nWebRTC: idle\nESP32: disconnected\nServo: —"
                    android:textColor="@color/text_secondary"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
