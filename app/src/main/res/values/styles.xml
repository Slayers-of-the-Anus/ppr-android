<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.RoboRouteCamera" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="Widget.PhonePilot.Button.Base" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.04</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.PhonePilot.Button.Primary" parent="Widget.PhonePilot.Button.Base">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Widget.PhonePilot.Button.Secondary" parent="Widget.PhonePilot.Button.Base">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Widget.PhonePilot.Button.Outline" parent="Widget.PhonePilot.Button.Base">
        <item name="android:background">@drawable/bg_button_outline</item>
        <item name="android:textColor">@color/brand</item>
    </style>

    <style name="Widget.PhonePilot.TelemetryCard" parent="">
        <item name="android:background">@drawable/bg_panel_dark</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:lineSpacingExtra">7dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.PhonePilot.SectionTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.11</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="Widget.PhonePilot.Input" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.PhonePilot.Radio" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <item name="android:buttonTint">@color/brand</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
